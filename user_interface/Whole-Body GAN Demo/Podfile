# Uncomment the next line to define a global platform for your project
platform :ios, '15.4'

target 'Whole-Body GAN Demo' do
  # Comment the next line if you don't want to use dynamic frameworks
  use_frameworks!

  # Pods for Whole-Body GAN Demo
  pod 'Firebase/Core'
  pod 'Firebase/Storage'
end

# Xcode 15+ rejects the ${DT_TOOLCHAIN_DIR} variable that CocoaPods' generated xcconfig files
# use in LIBRARY_SEARCH_PATHS; rewrite it to ${TOOLCHAIN_DIR} on every `pod install`.
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      xcconfig_path = config.base_configuration_reference&.real_path
      next unless xcconfig_path && File.exist?(xcconfig_path)

      xcconfig = File.read(xcconfig_path)
      updated = xcconfig.gsub('${DT_TOOLCHAIN_DIR}', '${TOOLCHAIN_DIR}')
      File.write(xcconfig_path, updated) if updated != xcconfig
    end
  end
end
